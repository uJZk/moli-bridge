+import undici, { Request } from 'undici';
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+
+import { config } from '@/config';
+import fetchWithPlaywrightRetry from '@/utils/playwright-fetch';
+import wrappedFetch from './fetch';
+
+vi.mock('@/utils/playwright-fetch', () => ({
+    default: vi.fn((request, nativeFetch) => nativeFetch(new Request(request, { redirect: 'manual' }))),
+}));
+
+describe('Moli Node retry gate', () => {
+    const originalEndpoint = config.playwrightCDPEndpoint;
+    const retry = vi.mocked(fetchWithPlaywrightRetry);
+    beforeEach(() => {
+        config.playwrightCDPEndpoint = 'http://127.0.0.1:9222';
+        vi.spyOn(undici, 'fetch').mockImplementation(async () => new undici.Response('ok'));
+        retry.mockClear();
+    });
+    afterEach(() => {
+        config.playwrightCDPEndpoint = originalEndpoint;
+        vi.restoreAllMocks();
+    });
+    test('uses the retry helper and preserves the original redirect mode', async () => {
+        await wrappedFetch('https://example.com/');
+        expect(retry).toHaveBeenCalledOnce();
+        expect(vi.mocked(undici.fetch).mock.calls[0][0]).toHaveProperty('redirect', 'follow');
+        await wrappedFetch('https://example.com/', { redirect: 'error' });
+        expect(vi.mocked(undici.fetch).mock.calls[1][0]).toHaveProperty('redirect', 'error');
+    });
+    test('does not enable Node replay without a CDP endpoint', async () => {
+        config.playwrightCDPEndpoint = '';
+        await wrappedFetch('https://example.com/');
+        expect(retry).not.toHaveBeenCalled();
+    });
+    test.each([
+        ['publicOnly', { publicOnly: true }],
+        ['dispatcher', { dispatcher: new undici.Agent() }],
+        ['TLS minimum', { minVersion: 'TLSv1.2' }],
+        ['HTTP/1 restriction', { allowH2: false }],
+        ['credential headers', { credentialHeaders: ['x-auth-token'] }],
+        ['response size override', { maxResponseSize: 1024 }],
+    ])('does not replay requests with %s', async (_label, init) => {
+        await wrappedFetch('https://example.com/', init as never);
+        expect(retry).not.toHaveBeenCalled();
+        expect(undici.fetch).toHaveBeenCalledOnce();
+    });
+});
